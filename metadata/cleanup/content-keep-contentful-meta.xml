<?xml version="1.0" encoding="UTF-8"?>
<!--
    Content object type cleanup - keep Contentful only.

    Use this INSTEAD OF metadata/meta/system-objecttype-extensions.xml when this
    org should expose Contentful fields only. That install file declares BOTH CMS
    groups, so importing it is what makes both sections appear on every asset.

    Import via Administration > Site Development > Import & Export > Meta Data,
    WITH "Delete existing attribute definitions and attribute groups not
    contained in the import file" CHECKED. Without that checkbox nothing is
    deleted - the import only re-creates what is already there.

    Result on the Content system object type:
      kept    : contentful* attributes + Contentful group
      removed : amplience* attributes + Amplience group
      removed : rcCms* attributes + CMS Migration group
      removed : ANY other custom Content attribute not listed below

    Only the Content type is touched; Site Preferences (rcMig*) are unaffected.
    Export the current Content metadata first as a backup.

    After this import the Amplience gallery cannot store or render data on this
    org - its wizard export still emits amplience* fields, but the library
    import will drop them.
-->
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">
    <type-extension type-id="Content">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="contentfulEntryId">
                <display-name xml:lang="x-default">Contentful Entry ID</display-name>
                <description xml:lang="x-default">Migrated Contentful CMS field</description>
                <type>string</type>
                <localizable-flag>false</localizable-flag>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="contentfulContentType">
                <display-name xml:lang="x-default">Contentful Content Type</display-name>
                <description xml:lang="x-default">Migrated Contentful CMS field</description>
                <type>string</type>
                <localizable-flag>false</localizable-flag>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="contentfulSlug">
                <display-name xml:lang="x-default">Contentful Slug</display-name>
                <description xml:lang="x-default">Migrated Contentful CMS field</description>
                <type>string</type>
                <localizable-flag>false</localizable-flag>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="contentfulWidgetType">
                <display-name xml:lang="x-default">Contentful Widget Type</display-name>
                <description xml:lang="x-default">Migrated Contentful CMS field</description>
                <type>string</type>
                <localizable-flag>false</localizable-flag>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="contentfulWidgetAttributes">
                <display-name xml:lang="x-default">Contentful Widget Attributes</display-name>
                <description xml:lang="x-default">Migrated Contentful CMS field</description>
                <type>text</type>
                <localizable-flag>false</localizable-flag>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="contentfulSourceJson">
                <display-name xml:lang="x-default">Contentful Source JSON</display-name>
                <description xml:lang="x-default">Migrated Contentful CMS field</description>
                <type>text</type>
                <localizable-flag>false</localizable-flag>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="contentfulImageUrl">
                <display-name xml:lang="x-default">Contentful Image URL</display-name>
                <description xml:lang="x-default">Migrated Contentful CMS field</description>
                <type>string</type>
                <localizable-flag>false</localizable-flag>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="Contentful">
                <display-name xml:lang="x-default">Contentful</display-name>
                <attribute attribute-id="contentfulEntryId"/>
                <attribute attribute-id="contentfulContentType"/>
                <attribute attribute-id="contentfulSlug"/>
                <attribute attribute-id="contentfulWidgetType"/>
                <attribute attribute-id="contentfulWidgetAttributes"/>
                <attribute attribute-id="contentfulSourceJson"/>
                <attribute attribute-id="contentfulImageUrl"/>
            </attribute-group>
        </group-definitions>
    </type-extension>
</metadata>
